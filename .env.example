# Redimir SPA — Archivo de Ejemplo para Variables de Entorno (.env)
# Copie este archivo a .env y configure los valores de su servidor de producción.

# Entorno y Seguridad
DEBUG=False
SECRET_KEY=clave-secreta-larga-y-aleatoria-generada-para-produccion
ALLOWED_HOSTS=plataforma.redimir.cl,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://plataforma.redimir.cl
CORS_ALLOWED_ORIGINS=https://plataforma.redimir.cl

# Base de Datos (Opcional, por defecto usa db.sqlite3)
# DATABASE_URL=postgres://usuario:password@localhost:5432/redimir_db

# Notificaciones y Servidor SMTP (Email)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notificaciones@redimir.cl
EMAIL_HOST_PASSWORD=contrasena-de-aplicacion-smtp
DEFAULT_FROM_EMAIL=Redimir SPA <notificaciones@redimir.cl>
